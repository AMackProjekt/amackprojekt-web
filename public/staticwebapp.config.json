{
  "routes": [
    {
      "route": "/api-test",
      "rewrite": "/api-test/index.html"
    },
    {
      "route": "/referral",
      "rewrite": "/referral/index.html"
    },
    {
      "route": "/joinwaitlist",
      "rewrite": "/joinwaitlist/index.html"
    },
    {
      "route": "/launch",
      "rewrite": "/launch/index.html"
    },
    {
      "route": "/solutions/retail",
      "rewrite": "/solutions/retail/index.html"
    },
    {
      "route": "/solutions/nonprofit",
      "rewrite": "/solutions/nonprofit/index.html"
    },
    {
      "route": "/solutions/healthcare",
      "rewrite": "/solutions/healthcare/index.html"
    },
    {
      "route": "/careport",
      "rewrite": "/careport/index.html"
    },
    {
      "route": "/portals",
      "rewrite": "/portals/index.html"
    },
    {
      "route": "/books",
      "rewrite": "/books/index.html"
    },
    {
      "route": "/messaging",
      "redirect": "/innovation/",
      "statusCode": 301
    },
    {
      "route": "/messaging/*",
      "redirect": "/innovation/",
      "statusCode": 301
    },
    {
      "route": "/portal",
      "redirect": "https://sdtoolsinc.org",
      "statusCode": 301
    },
    {
      "route": "/portal/*",
      "redirect": "https://sdtoolsinc.org",
      "statusCode": 301
    },
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/innovation",
      "rewrite": "/innovation/index.html"
    },
    {
      "route": "/partnerships",
      "rewrite": "/partnerships/index.html"
    },
    {
      "route": "/media-kit",
      "rewrite": "/media-kit/index.html"
    },
    {
      "route": "/interest",
      "rewrite": "/interest/index.html"
    },
    {
      "route": "/waitlist",
      "rewrite": "/waitlist/index.html"
    },
    {
      "route": "/reentry",
      "rewrite": "/reentry/index.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy/index.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms/index.html"
    },
    {
      "route": "/api/*"
    },
    {
      "route": "/_next/static/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/logos/*",
      "headers": {
        "cache-control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/service-worker.js",
      "headers": {
        "cache-control": "no-cache, must-revalidate",
        "content-type": "application/javascript"
      }
    },
    {
      "route": "/*.{js,css,woff,woff2,ttf}",
      "headers": {
        "cache-control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/*.{html,json}",
      "headers": {
        "cache-control": "no-cache, must-revalidate"
      }
    },
    {
      "route": "/*",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ],
      "methods": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "DELETE",
        "OPTIONS"
      ],
      "headers": {
        "cache-control": "no-cache, must-revalidate"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/_next/*",
      "/logos/*",
      "/partnerships/*",
      "/videos/*",
      "/service-worker.js",
      "/manifest.json",
      "/*.{js,css,json,png,jpg,jpeg,gif,webp,svg,ico,woff,woff2,ttf,mp4}"
    ]
  },
  "mimeTypes": {
    ".js": "application/javascript",
    ".json": "application/json",
    ".jpeg": "image/jpeg",
    ".webp": "image/webp",
    ".woff2": "font/woff2",
    ".woff": "font/woff",
    ".ttf": "font/ttf"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-XSS-Protection": "1; mode=block",
    "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()",
    "Cache-Control": "no-cache, must-revalidate"
  },
  "platform": {
    "apiRuntime": "node:18"
  }
}
